# AI Provider Configuration
# Works with GitHub Models OR Microsoft Foundry - just change the values below!

# =============================================================================
# OPTION 1: GitHub Models (Free - Good for Learning)
# =============================================================================
# Get your GitHub Personal Access Token at: https://github.com/settings/tokens
# No special scopes needed - just generate a token

AI_API_KEY=your_github_personal_access_token
AI_ENDPOINT=https://models.inference.ai.azure.com
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-ada-002

# =============================================================================
# OPTION 2: Microsoft Foundry (Paid - For Production)
# =============================================================================
# Uncomment these lines and comment out the GitHub Models section above
# Get your Azure OpenAI endpoint and key from Azure Portal

# AI_API_KEY=your_azure_openai_api_key
# AI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# AI_MODEL=gpt-5-mini
# AI_EMBEDDING_MODEL=text-embedding-ada-002

# =============================================================================
# CHAPTER 09 ONLY: Hosted agent deployment to an existing Foundry project
# =============================================================================
# When completing Chapter 09, configure the OPTION 2 values in the repository
# root .env, then replace these deployment placeholders.

AZURE_SUBSCRIPTION_ID=<subscription-id>
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<resource>/projects/<project>
AZURE_LOCATION=<azure-region>