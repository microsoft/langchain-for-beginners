# Microsoft Foundry model configuration for Chapter 09
# Authentication uses DefaultAzureCredential. Run `az login` before local use;
# Foundry provides the hosted agent's Microsoft Entra identity after deployment.
# Replace <resource> and <project> with values from your Foundry project.

AI_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small