# Microsoft Foundry model configuration for Chapter 09
# Authentication uses DefaultAzureCredential. Run `az login` before local use;
# Foundry provides the hosted agent's Microsoft Entra identity after deployment.

AI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-ada-002