# Microsoft Foundry configuration for Chapter 09
# Replace the placeholders with values from your Foundry project.

# azd deployment configuration (not read by the local Python application)
AZURE_SUBSCRIPTION_ID=<subscription-id>
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<resource>/projects/<project>
AZURE_LOCATION=<azure-region>

# Agent runtime model configuration
# Authentication uses DefaultAzureCredential. Run `az login` before local use;
# Foundry provides the hosted agent's Microsoft Entra identity after deployment.
AI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_API_KEY=<API Key provided by Microsoft Foundry>